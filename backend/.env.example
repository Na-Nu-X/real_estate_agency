# Copy to .env and adjust. All values are optional for local development.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# Leave empty for SQLite. For PostgreSQL (install psycopg[binary]):
# DATABASE_URL=postgres://reality:password@localhost:5432/reality
# DATABASE_URL=
